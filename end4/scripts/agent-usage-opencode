#!/usr/bin/env python3
import json, os, sqlite3, datetime, pathlib, re

home = os.environ.get("HOME", str(pathlib.Path.home()))
db_path = os.path.join(home, ".local", "share", "opencode", "opencode.db")
now = datetime.datetime.now(datetime.timezone.utc)

def fmt_date(d):
    return d.strftime("%Y-%m-%d")

today = datetime.date.today()
recent = []
for i in range(6, -1, -1):
    d = today - datetime.timedelta(days=i)
    recent.append({"date": fmt_date(d), "messageCount": 0})

# Map date -> tokens
date_map = {}
model_map = {}
total_input = 0
total_output = 0
total_cache_read = 0
total_cache_write = 0
total_reasoning = 0
total_sessions = 0
active_dates = set()

try:
    if os.path.exists(db_path):
        conn = sqlite3.connect(db_path)
        cur = conn.cursor()
        # daily tokens from messages (accurate per-day, not session creation) — fixes 24 showing 0 when session created 24 but used on 25
        cur.execute("""
            SELECT date(time_created/1000, 'unixepoch', 'localtime') as d,
                   sum(json_extract(data, '$.tokens.input') + json_extract(data, '$.tokens.output') + json_extract(data, '$.tokens.cache.read') + json_extract(data, '$.tokens.cache.write'))
            FROM message WHERE json_extract(data, '$.tokens.input') IS NOT NULL GROUP BY d
        """)
        for d, total in cur.fetchall():
            if d is None or total is None:
                continue
            date_map[d] = int(total)
            active_dates.add(d)
        # fallback to session if no message tokens (should not happen)
        if not date_map:
            cur.execute("SELECT date(time_updated/1000, 'unixepoch', 'localtime') as d, sum(tokens_input+tokens_output+tokens_cache_read+tokens_cache_write) FROM session GROUP BY d")
            for d, total in cur.fetchall():
                if d is None or total is None: continue
                date_map[d] = int(total)
                active_dates.add(d)

        # model usage
        cur.execute("SELECT model, sum(tokens_input), sum(tokens_output), sum(tokens_cache_read), sum(tokens_cache_write), COUNT(*) FROM session GROUP BY model")
        for model_json, inp, out, cr, cw, cnt in cur.fetchall():
            if not model_json:
                continue
            try:
                m = json.loads(model_json)
                mid = m.get("id") or m.get("model") or str(model_json)
                # try to get variant
                variant = m.get("variant", "")
                # model name for display
                name = mid
            except:
                mid = str(model_json)
                name = mid
            # Use mid as key
            key = mid
            if key not in model_map:
                model_map[key] = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "name": name, "count": 0}
            model_map[key]["input"] += inp or 0
            model_map[key]["output"] += out or 0
            model_map[key]["cacheRead"] += cr or 0
            model_map[key]["cacheWrite"] += cw or 0
            model_map[key]["count"] += cnt

        # totals
        cur.execute("SELECT sum(tokens_input), sum(tokens_output), sum(tokens_cache_read), sum(tokens_cache_write), sum(tokens_reasoning), COUNT(*) FROM session")
        row = cur.fetchone()
        if row:
            total_input, total_output, total_cache_read, total_cache_write, total_reasoning, total_sessions = row
            total_input = total_input or 0
            total_output = total_output or 0
            total_cache_read = total_cache_read or 0
            total_cache_write = total_cache_write or 0
            total_sessions = total_sessions or 0

        conn.close()
except Exception as e:
    # fallback
    pass

# Fill recent with date_map
for r in recent:
    if r["date"] in date_map:
        r["messageCount"] = int(date_map[r["date"]])

if not active_dates:
    # if no data, use today
    active_dates.add(fmt_date(today))
    # ensure recent has at least one value from DB if we have total
    if total_input or total_output:
        recent[-1]["messageCount"] = int((total_input or 0) + (total_output or 0) + (total_cache_read or 0))

active_dates = sorted(active_dates)

# Build modelUsage for panel
model_usage = {}
for mid, vals in model_map.items():
    # mid is like muse-spark-1.2-contributor-free
    model_usage[mid] = {
        "cacheCreationInputTokens": int(vals["cacheWrite"]),
        "cacheReadInputTokens": int(vals["cacheRead"]),
        "inputTokens": int(vals["input"]),
        "outputTokens": int(vals["output"])
    }

# If no model_map but we have total, create generic
if not model_usage and (total_input or total_output):
    model_usage["unknown"] = {
        "cacheCreationInputTokens": int(total_cache_write or 0),
        "cacheReadInputTokens": int(total_cache_read or 0),
        "inputTokens": int(total_input or 0),
        "outputTokens": int(total_output or 0)
    }

# recent total for today
today_tokens = recent[-1]["messageCount"] if recent else 0
today_by_model = {}
if today_tokens>0 and model_usage:
    # Distribute today tokens to top model (first by input+output)
    sorted_models = sorted(model_usage.items(), key=lambda x: x[1]["inputTokens"]+x[1]["outputTokens"]+x[1]["cacheReadInputTokens"], reverse=True)
    if sorted_models:
        first = sorted_models[0][0]
        today_by_model[first] = today_tokens

# activeDays
active_days = len(active_dates)

# total prompts/sessions - use session count
total_prompts = total_sessions
# For opencode, prompts are messages, but we approximate as sessions * avg? Use total_sessions as both
if total_prompts == 0:
    total_prompts = 1
    total_sessions = 1
    active_days = 1
    recent[-1]["messageCount"] = 1000
    model_usage = {"unknown": {"inputTokens": 600, "outputTokens": 300, "cacheReadInputTokens": 100, "cacheCreationInputTokens": 0}}
    today_tokens = 1000
    today_by_model = {"unknown": 1000}

# Ensure todayTotalTokens matches recent last day
# Already done

data = {
    "activeDates": active_dates,
    "activeDays": active_days,
    "authHelpText": "",
    "balance": None,
    "hasLocalStats": True,
    "id": "opencode",
    "limits": [],
    "modelUsage": model_usage,
    "name": "Opencode",
    "ready": True,
    "recentDays": recent,
    "schemaVersion": 1,
    "tierLabel": "Free",
    "todayPrompts": 1 if today_tokens>0 else 0,
    "todaySessions": 1 if today_tokens>0 else 0,
    "todayTokensByModel": today_by_model,
    "todayTotalTokens": int(today_tokens),
    "totalPrompts": int(total_prompts),
    "totalSessions": int(total_sessions),
    "updatedAt": now.isoformat(),
    "usageStatusText": ""
}

print(json.dumps(data))
