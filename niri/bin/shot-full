#!/usr/bin/env bash
# shot-full — instant full-screen screenshot to the clipboard.
#
# Backed by niri's built-in `screenshot-screen` action which uses the same
# wlr-screencopy handshake as grim, but fires it directly from the compositor
# (no shell pipeline, no slurp overlay between the keybind and the
# screencopy). Result: open dropdowns / menus / popups are captured exactly
# as rendered at the instant the keybind runs, with nothing in between to
# dismiss them.
#
# Side effect (kept): also writes to the path set in niri's screenshot-path
# config, matching what `Print` does.

set -euo pipefail

if ! command -v niri &>/dev/null; then
    echo "shot-full: requires niri running" >&2
    exit 1
fi

exec niri msg action screenshot-screen --show-pointer true
