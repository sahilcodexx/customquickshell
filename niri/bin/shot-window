#!/usr/bin/env bash
# shot-window — screenshot the focused window to the clipboard.
#
# Backed by niri's built-in `screenshot-window` action: it grabs the focused
# window's foreign-toplevel frame and forwards it via wlr-screencopy. Since
# the focused window owns any open dropdown / popup attached to it, transient
# UI is captured as part of the toplevel.
#
# Replaces the previous `grim + jq over niri focused-window` pipeline — same
# observable behaviour, fewer moving parts, no slurp, no jq parse.

set -euo pipefail

if ! command -v niri &>/dev/null; then
    echo "shot-window: requires niri running" >&2
    exit 1
fi

exec niri msg action screenshot-window --show-pointer true
