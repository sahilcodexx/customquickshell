#!/usr/bin/env bash
# shot-region — interactively select a screen region with the niri-built-in
# region picker, save to clipboard.
#
# Backed by niri's `screenshot` action which opens niri's own picker UI
# (built into the compositor — uses its own layer-shell surface, not slurp).
# Captures whatever's in the framebuffer at picker-confirm time.
#
# We still keep the same --delay <ms> shape as before so end4 / Hyprland users
# recognise the timing-sensitivity mitigation; for niri the delay is
# generally unnecessary since niri's picker doesn't behave the same way as
# slurp (it doesn't need to steal keyboard focus from the focused window).

set -euo pipefail

if ! command -v niri &>/dev/null; then
    echo "shot-region: requires niri running" >&2
    exit 1
fi

delay_ms=0
if [[ "${1:-}" == "--delay" ]]; then
    delay_ms="${2:-0}"
fi

if [[ "$delay_ms" -gt 0 ]]; then
    notify-send -a shot-region -t "$delay_ms" \
        "Screenshot in $((delay_ms / 1000))s — open dropdowns / menus now"
    sleep "$(awk -v ms="$delay_ms" 'BEGIN { printf "%.3f", ms / 1000 }')"
fi

exec niri msg action screenshot --show-pointer true
