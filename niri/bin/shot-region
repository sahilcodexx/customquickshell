#!/usr/bin/env bash
# shot-region — pick a screen region with slurp, capture with grim, copy to
# clipboard. Optional --delay <ms> opens the picker after a countdown so the
# caller can position dropdowns / menus / tooltips before the picker pops.
#
# Default delay matches Hyprland-style screenshot behaviour: 0ms (no delay).
# Pass `--delay 1500` for a 1.5s countdown.

set -euo pipefail

for cmd in grim slurp wl-copy; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "shot-region: required command '$cmd' not found in PATH" >&2
        exit 1
    fi
done

delay_ms=0
if [[ "${1:-}" == "--delay" ]]; then
    delay_ms="${2:-0}"
fi

# Snackbar-style count-up so the user knows how long they have. notify-send is
# the same channel Hyprland uses for screenshot capture notifications.
if [[ "$delay_ms" -gt 0 ]]; then
    notify-send -a shot-region -t "$delay_ms" \
        "Screenshot in $((delay_ms / 1000))s — open dropdowns / menus now"
    sleep "$(awk -v ms="$delay_ms" 'BEGIN { printf "%.3f", ms / 1000 }')"
fi

# slurp prints the selected geometry on stdout and exits 0. Esc/right-click
# makes slurp exit non-zero with no output — treat that as cancel.
if ! geom=$(slurp 2>/dev/null); then
    exit 0
fi
if [[ -z "$geom" ]]; then
    exit 0
fi

grim -g "$geom" - | wl-copy --type image/png
